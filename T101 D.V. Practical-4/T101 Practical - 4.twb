      <aliases enabled='yes' />
      <column caption='Profit Margin Ratio' datatype='real' name='[Calculation_0375236802203649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Profit]/[Sales]' />
      </column>
      <column caption='Total revenue before discount' datatype='real' name='[Calculation_0375236804059139]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Sales]*[Quantity]' />
      </column>
      <column caption='Aggregate Profit Margin' datatype='real' name='[Calculation_0375236818595845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='Fixed Regional Sales' datatype='real' name='[Calculation_0375236827455494]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[State]:SUM([Sales])}' />
      </column>
      <column caption='Include Sales per Customer' datatype='real' name='[Calculation_0375236849569799]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE[Customer ID] : SUM([Sales])}' />
      </column>
      <column aggregation='Attribute' caption='Exclude category Sales' datatype='real' name='[Calculation_0375236851994633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{EXCLUDE [Sub-Category] : SUM([Sales])}' />
      </column>
      <column caption='KPI Threshold Met?' datatype='string' name='[Calculation_0375236854775819]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= [Parameters].[Parameter 0375236853653514] THEN &quot;Target Achieved&quot;&#13;&#10;ELSE &quot;Below Target&quot; END' />
      </column>
      <column caption='Cleaned Discount' datatype='real' name='[Calculation_0375236857557005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([Discount], 0)' />
      </column>
      <column caption='Standardized City type' datatype='string' name='[Calculation_0375236858363920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='UPPER([City Type])' />
      </column>
      <column datatype='string' name='[City Type]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column aggregation='Sum' datatype='integer' default-format='*00000' name='[Postal Code]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
      <column datatype='integer' name='[Year]' role='dimension' type='quantitative' />
      <column caption='store_sales_data.csv' datatype='table' name='[__tableau_internal_object_id__].[store_sales_data.csv_E97C952E48C74749BC8C682CCDE65867]' role='measure' type='quantitative' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
